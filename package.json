{
  "name": "my-sdet-framework",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:ui": "playwright test --project=chromium",
    "test:smoke": "playwright test --project=chromium --grep @smoke",
    "test:regression": "playwright test --project=chromium --grep @regression",
    "test:e2e": "playwright test --project=chromium --grep @e2e",
    "test:cross": "playwright test --project=chromium --project=firefox --project=webkit --grep @smoke",
    "test:learning": "playwright test --project=learning",
    "test:headed": "playwright test --project=chromium --headed --workers=1",
    "report": "playwright show-report",
    "codegen": "playwright codegen https://www.saucedemo.com"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "allure": "^3.33.0",
    "allure-playwright": "^3.14.0",
    "dotenv": "^18.0.9",
    "typescript": "^7.0.2"
  }
  
}
