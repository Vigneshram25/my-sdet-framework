# ===========================================
# Environment config — copy to .env and fill in real values
# .env is NEVER committed (it is in .gitignore)
# ===========================================

# Which environment the tests run against (qa / staging)
ENV=qa

# ---------- UI (Sauce Demo) ----------
UI_BASE_URL=https://www.saucedemo.com
SAUCE_USER=standard_user
SAUCE_PASSWORD=secret_sauce

# ---------- API (Restful Booker) ----------
API_BASE_URL=https://restful-booker.herokuapp.com
BOOKER_USER=admin
BOOKER_PASSWORD=password123

# ---------- Database (PostgreSQL, set up in Phase 5) ----------
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/shopdb

# DummyJSON (Bearer token / JWT practice API)
DUMMY_USER=emilys
DUMMY_PASSWORD=emilyspass